# Copy this file to .env and fill in the values. Never commit .env.

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ordermind

# At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# Password for the demo users created by scripts/seed_demo.py
DEMO_PASSWORD=

# Claude (Stage 3 onwards)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_EFFORT=low
# ANTHROPIC_MAX_TOKENS=4096

# Business rules (optional overrides, defaults live in app/config.py)
# RETURN_WINDOW_DAYS=14
# AUTO_APPROVE_REFUND_LIMIT=100
# MAX_TOOL_CALLS_PER_TURN=5
# HISTORY_MESSAGES=12
# PENDING_ACTION_TTL_MINUTES=5
# MAX_TICKETS_PER_DAY=3
